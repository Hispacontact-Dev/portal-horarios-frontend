{
  "extends": "next/core-web-vitals",
  "overrides": [
    {
      "files": [
        "src/**/*.ts",
        "src/**/*.tsx"
      ],
      "excludedFiles": [
        "src/modules/operacion/**",
        "src/app/(ops)/**",
        "src/middleware.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@ops",
                  "@ops/**",
                  "@/modules/**"
                ],
                "message": "El portal de Junta Directiva no importa del módulo de operación: la frontera va en una sola dirección (T-003)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/modules/operacion/**/*.ts",
        "src/modules/operacion/**/*.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/lib/api/*",
                  "!@/lib/api/client",
                  "!@/lib/api/errors"
                ],
                "message": "El módulo de operación solo consume el chasis por los adaptadores de T-000 §3.1/§3.2: ver la lista en src/modules/operacion/README.md."
              },
              {
                "group": [
                  "@/lib/hooks/*",
                  "!@/lib/hooks/useAsyncResource",
                  "!@/lib/hooks/useAsyncAction",
                  "!@/lib/hooks/useAuth",
                  "!@/lib/hooks/useToast",
                  "!@/lib/hooks/useSuccessFlag",
                  "!@/lib/hooks/useNowTick",
                  "!@/lib/hooks/useDismissibleNotice"
                ],
                "message": "El módulo de operación solo consume el chasis por los adaptadores de T-000 §3.1/§3.2: ver la lista en src/modules/operacion/README.md."
              },
              {
                "group": [
                  "@/lib/utils/*",
                  "!@/lib/utils/cn",
                  "!@/lib/utils/week",
                  "!@/lib/utils/time",
                  "!@/lib/utils/date",
                  "!@/lib/utils/csv",
                  "!@/lib/utils/constants",
                  "!@/lib/utils/role"
                ],
                "message": "El módulo de operación solo consume el chasis por los adaptadores de T-000 §3.1/§3.2: ver la lista en src/modules/operacion/README.md."
              },
              {
                "group": [
                  "@/components/*/**",
                  "!@/components/ui/**",
                  "!@/components/layout/**"
                ],
                "message": "El módulo de operación solo consume el chasis por los adaptadores de T-000 §3.1/§3.2: ver la lista en src/modules/operacion/README.md."
              },
              {
                "group": [
                  "@/types/*",
                  "!@/types/session"
                ],
                "message": "El módulo de operación solo consume el chasis por los adaptadores de T-000 §3.1/§3.2: ver la lista en src/modules/operacion/README.md."
              },
              {
                "group": [
                  "@/context/**",
                  "@/app/**",
                  "@/lib/session/**"
                ],
                "message": "El módulo de operación solo consume el chasis por los adaptadores de T-000 §3.1/§3.2: ver la lista en src/modules/operacion/README.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/app/(ops)/**/*.tsx",
        "src/middleware.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@ops/*/*"
                ],
                "message": "Importá el barril de la capa (@ops/components, @ops/pages, @ops/utils), no un archivo interno del módulo (T-003)."
              }
            ]
          }
        ]
      }
    }
  ]
}
